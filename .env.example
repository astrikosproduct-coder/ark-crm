# ARK CRM — settings for docker-compose.yml.
#
# Copy to .env beside docker-compose.yml and fill in. .env is git-ignored and
# must stay that way: it holds the database password and two secrets. Never
# reuse development values in production.

# ---- The address people type -------------------------------------------------
# The hostname only, e.g. crm.astrikos.ai — Caddy fetches the HTTPS certificate
# for it. Use :80 to try the stack on a laptop over plain HTTP.
SITE_ADDRESS=:80
# The same address as a URL, no trailing slash. Must match the redirect URI on
# the Entra app registration exactly: <APP_BASE_URL>/api/auth/callback
APP_BASE_URL=http://localhost
# true whenever APP_BASE_URL is https. false only for the plain-HTTP laptop test.
SESSION_HTTPS_ONLY=false

# Host ports. Change only if 80/443 are taken on this machine.
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database ------------------------------------------------------------------
# Used to create the database on first start. Avoid @ : / in the password —
# they break the connection URL.
POSTGRES_USER=ark
POSTGRES_PASSWORD=
POSTGRES_DB=ark_crm

# ---- Microsoft Entra sign-in -----------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ---- Session -------------------------------------------------------------------
# Signs the sign-in cookie. Generate ONCE per environment and keep it: changing
# it signs everybody out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
