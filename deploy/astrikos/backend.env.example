# ARK CRM backend settings for the astrikos.xyz server (crm.astrikos.xyz).
#
# Copy to backend/.env ON THE SERVER, fill in the blanks, chmod 600. Never
# commit the filled-in copy (.gitignore already refuses backend/.env), and
# never reuse the development values.
#
# PORT is NOT set here: it is passed on the pm2 command line (PORT=4329 ...),
# as the server convention requires.

# PostgreSQL on this server, reachable on 127.0.0.1 only (DEPLOY.md, step 2).
# Avoid @ : / in the password — they break this URL.
DATABASE_URL=postgresql+psycopg://ark:PASSWORD@127.0.0.1:5433/ark_crm

# Microsoft Entra sign-in (single-tenant app registration).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Signs the session cookie. Generate ONCE and keep it — changing it signs
# everybody out:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# The address people type, no trailing slash. The Entra app registration must
# list <APP_BASE_URL>/api/auth/callback as a redirect URI, character for
# character — including the :8443.
APP_BASE_URL=https://crm.astrikos.xyz:8443
SESSION_HTTPS_ONLY=true

SQL_ECHO=false
