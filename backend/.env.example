# ARK CRM backend configuration.
#
# Copy this file to `.env` beside it and fill in real values. `.env` is
# git-ignored; this file is not, so it must NEVER hold a real value.
# In production, set these in the host's environment or a secret store
# rather than a file — and never reuse the development values.

# PostgreSQL connection. Development runs Postgres in Docker on host port 5433.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/ark_crm

# Microsoft Entra sign-in (single-tenant app registration).
# Tenant and client ids are not secret; the client secret is.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Signs the session cookie. MUST be set and stable in any real deployment:
# left unset, a random one is generated at startup and every restart signs
# everybody out. Generate once, e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# The address people type to reach the app, with no trailing slash. Builds the
# sign-in redirect URI, which must match one registered on the Entra app
# registration exactly: <APP_BASE_URL>/api/auth/callback
APP_BASE_URL=http://localhost:5173

# true in production (HTTPS). Leave false for local http://localhost.
SESSION_HTTPS_ONLY=false

# The month the fiscal year starts in, 1-12. Default 4: FY27 runs 01 Apr 2026 to
# 31 Mar 2027. Every dashboard quarter and sales target follows it (app/fiscal.py).
# Set it once, before any target exists.
FISCAL_YEAR_START_MONTH=4

# The month-end pipeline snapshot timer (app/pipeline_snapshots.py). On unless set
# to off — turn it off only on a second instance sharing the same database.
PIPELINE_SNAPSHOT_TIMER=on

# true logs every SQL statement with its values. Development only — never in
# production, where it would write client data into the server log.
SQL_ECHO=false
